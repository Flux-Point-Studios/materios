use frame_support::{traits::Get, weights::Weight};

{{#each benchmarks as |benchmark|}}
pub fn {{benchmark.name}}<T: frame_system::Config>({{#each benchmark.components as |c|}}{{c.name}}: u32,{{/each}}) -> Weight {
    {{#if (eq benchmark.name "attest_bad_hash")}}
    let proof = 29_185;
    {{else}}{{#if (or (eq benchmark.name "attest_threshold") (eq benchmark.name "attest_dead_treasury"))}}
    let proof = 43_329_u64.saturating_add(7_122_u64.saturating_mul(n.into()));
    {{else}}
    let proof = 20_083;
    {{/if}}{{/if}}
    Weight::from_parts({{underscore benchmark.base_weight}}, proof)
        {{#each benchmark.component_weight as |cw|}}
        .saturating_add(Weight::from_parts({{underscore cw.slope}}, 0).saturating_mul({{cw.name}}.into()))
        {{/each}}
        .saturating_add(T::DbWeight::get().reads({{benchmark.base_reads}}))
        {{#each benchmark.component_reads as |cr|}}
        .saturating_add(T::DbWeight::get().reads({{cr.slope}}_u64.saturating_mul({{cr.name}}.into())))
        {{/each}}
        .saturating_add(T::DbWeight::get().writes({{benchmark.base_writes}}))
        {{#each benchmark.component_writes as |cw|}}
        .saturating_add(T::DbWeight::get().writes({{cw.slope}}_u64.saturating_mul({{cw.name}}.into())))
        {{/each}}
        {{#if (or (eq benchmark.name "attest_threshold") (eq benchmark.name "attest_dead_treasury"))}}
        // The samples hold the checkpoint of each signer and of the treasury
        // or refunded submitter, which `balance_mutations` charges.
        .saturating_sub(T::DbWeight::get().reads_writes(1 + u64::from(n), 1 + u64::from(n)))
        {{/if}}
}
{{/each}}
